# Public build settings (no secrets). Voice languages: Spanish is always on; English since the
# feature 014 eval gate passed (T073/T074, 2026-11-07).
VITE_VOICE_LANGUAGES=es,en
# Whisper (feature 015): add a language only after its audio check gate passes (T054).
# es, en: passed 2026-11-07 with the relaxed gate (SC-002). Accuracy and names from
# eval/audio/results/2026-11-07T20-49-31-whisper-large-v3-turbo.json, speed from the fresh run
# 2026-11-07T20-18-55-whisper-large-v3-turbo.json.
VITE_WHISPER_LANGUAGES=es,en
